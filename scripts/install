#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# GENERATE THE WEBUI PASSWORD
#=================================================
ynh_script_progression "Generating qBittorrent's WebUI password..."

# __PATH__/ext is exposed to visitors so external clients can reach the API without
# the SSO, so qBittorrent must authenticate those requests itself.
password=$(ynh_string_random --length=24)
ynh_app_setting_set --key=password --value="$password"
password_pbkdf2=$(qbittorrent_password_pbkdf2 "$password")

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app ..."

# Create a dedicated NGINX config using the conf/nginx.conf template
ynh_config_add_nginx

# Create a dedicated systemd config
ynh_config_add_systemd

log_dir="$data_dir/logs"
mkdir -p "$log_dir"
touch "$log_dir/qbittorrent.log"

yunohost service add $app --description="qBittorrent-nox service"

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

config_dir="$data_dir/qBittorrent/config"
mkdir -p "$config_dir"

ynh_config_add --template="qBittorrent.conf" --destination="$config_dir/qBittorrent.conf"

chown -R $app: "$data_dir"
chown -R $app: "$install_dir"
chmod 600 "$config_dir/qBittorrent.conf"

#=================================================
# YUNOHOST MULTIMEDIA INTEGRATION
#=================================================
ynh_script_progression "Adding multimedia directories..."

# Build YunoHost multimedia directories
ynh_multimedia_build_main_dir

ynh_multimedia_addfolder --source_dir="$data_dir" --dest_dir="share/Torrents"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start a systemd service
ynh_systemctl --service=$app --action=start --wait_until="Now listening on IP" --log_path="$data_dir/qBittorrent/data/logs/qbittorrent.log" --timeout=30

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
