#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service=$app --action="stop"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

log_dir="$data_dir/.local/share/data/qBittorrent/logs"
mkdir -p "$log_dir"
touch "$log_dir/qbittorrent.log"

yunohost service add $app --description="qBittorrent-nox service" --log="$log_dir/qbittorrent.log"

old_config_dir="$install_dir/.config/qBittorrent"
new_config_dir="$data_dir/.config/qBittorrent"
if [ -d "$old_config_dir" ]; then
	mkdir -p "$new_config_dir"
	if [ -f "$old_config_dir/qBittorrent.conf" ] && [ ! -f "$new_config_dir/qBittorrent.conf" ]; then
		mv "$old_config_dir/qBittorrent.conf" "$new_config_dir/qBittorrent.conf"
	fi
	if [ -d "$old_config_dir" ]; then
		rmdir --ignore-fail-on-non-empty "$old_config_dir" 2>/dev/null || true
	fi
fi

mkdir -p "$new_config_dir"
ynh_config_add --template="qBittorrent.conf" --destination="$new_config_dir/qBittorrent.conf"
chmod 600 "$new_config_dir/qBittorrent.conf"

chown -R $app: "$data_dir"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service=$app --action=start --wait_until="Web UI: Now listening on IP" --log_path="systemd" --timeout=120

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
