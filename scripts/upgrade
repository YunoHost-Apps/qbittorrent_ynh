#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service=$app --action="stop"

#=================================================
# ENFORCE QBITTORRENT'S OWN AUTHENTICATION
#=================================================
ynh_script_progression "Checking qBittorrent's WebUI authentication..."

# Up to 4.2.5~ynh3, /api was public while qBittorrent skipped auth for proxied
# requests: the admin API was open. It is now admin-only, external clients use /ext.
qbittorrent_conf="$install_dir/qBittorrent/config/qBittorrent.conf"

qbittorrent_data="$install_dir/qBittorrent/data"
mkdir -p "$(dirname "$qbittorrent_conf")" "$qbittorrent_data/BT_backup"

if ynh_app_upgrading_from_version_before 4.5.2~ynh2; then
    # The profile moved around a lot: XDG dirs under $install_dir, then $data_dir. It now
    # lives in $install_dir, out of reach of the recursive ACLs multimedia apps apply.
    if [ ! -f "$qbittorrent_conf" ]; then
        for legacy_conf in "$data_dir/qBittorrent/config/qBittorrent.conf" "$data_dir/.config/qBittorrent/qBittorrent.conf" "$install_dir/.config/qBittorrent/qBittorrent.conf"; do
            if [ -f "$legacy_conf" ]; then
                mv "$legacy_conf" "$qbittorrent_conf"
                break
            fi
        done
    fi

    # Torrents and their resume data follow the profile. Copy rather than move, so a
    # failed upgrade leaves the previous location intact.
    if [ -z "$(ls -A "$qbittorrent_data/BT_backup" 2>/dev/null)" ]; then
        for legacy_data in "$data_dir/qBittorrent/data" "$install_dir/.local/share/qBittorrent" "$install_dir/.local/share/data/qBittorrent"; do
            if [ -d "$legacy_data/BT_backup" ]; then
                cp -a "$legacy_data/." "$qbittorrent_data/"
                ynh_app_setting_set --key=legacy_profile --value="$legacy_data"
                break
            fi
        done
    fi
fi

if [ ! -f "$qbittorrent_conf" ]; then
    password=$(ynh_string_random --length=24)
    ynh_app_setting_set --key=password --value="$password"
    password_pbkdf2=$(qbittorrent_password_pbkdf2 "$password")
    ynh_config_add --template="qBittorrent.conf" --destination="$qbittorrent_conf"
fi

qbittorrent_conf_set "$qbittorrent_conf" 'WebUI\ReverseProxySupportEnabled' "true"
qbittorrent_conf_set "$qbittorrent_conf" 'WebUI\TrustedReverseProxiesList' "127.0.0.1"

# Also reset the hardcoded "adminadmin" default, which is what an absent
# Password_PBKDF2 means on 4.5.x. A password the admin chose is left alone.
if ! grep -qF 'WebUI\Password_PBKDF2=' "$qbittorrent_conf" \
    || qbittorrent_password_is "$qbittorrent_conf" "adminadmin"; then
    password=$(ynh_string_random --length=24)
    ynh_app_setting_set --key=password --value="$password"
    qbittorrent_conf_set "$qbittorrent_conf" 'WebUI\Password_PBKDF2' \
        "\"@ByteArray($(qbittorrent_password_pbkdf2 "$password"))\""
fi

chown -R "$app:" "$install_dir/qBittorrent"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add $app --description="qBittorrent-nox service"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service=$app --action=start

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
